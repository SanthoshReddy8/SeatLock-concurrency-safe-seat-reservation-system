{
  "name": "seat-booking-engine",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "npm run build:api && npm --prefix web run build",
    "build:api": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/server.js",
    "test": "jest --runInBand",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:infra": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/worker.ts",
    "load:test": "k6 run load/k6.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
